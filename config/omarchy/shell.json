{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 1800
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.menu"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "ram",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/ram-usage",
          "interval": 3,
          "tooltip": "RAM usage",
          "onClick": "omarchy-launch-or-focus-tui btop"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": []
}
