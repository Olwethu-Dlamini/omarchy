{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "bluetooth",
        "cpu",
        "memory",
        "battery",
        "tray"
    ],
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },
    "clock": {
        "format": "  {:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "format-alt": "{:%A %d %B %Y}"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "/home/olwethu/.config/waybar/toggle.sh pavucontrol pavucontrol",
        "tooltip": true,
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤭 offline",
        "tooltip-format-wifi": "{essid}  {signalStrength}%",
        "tooltip-format": "{ifname}  {signalStrength}%",
        "on-click": "/home/olwethu/.config/waybar/toggle.sh nm-connection-editor nm-connection-editor",
        "tooltip": true
    },
    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 3,
        "tooltip": true
    },
    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 5,
        "tooltip": true
    },
    "battery": {
        "states": {
            "warning": 25,
            "critical": 12
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰁹"
        ],
        "tooltip": true
    },
    "tray": {
        "spacing": 10
    },
    "bluetooth": {
        "format": "󰂯 {status}",
        "format-connected": "󰂱 {device_alias}",
        "format-off": "󰂲",
        "on-click": "/home/olwethu/.config/waybar/toggle.sh blueman-manager blueman-manager",
        "tooltip": true
    }
}