### Variables
set $mod Mod4
set $term foot
set $menu wofi --show drun
set $left h
set $down j
set $up k
set $right l

### Look: gaps, borders, colours (Gruvbox)
font pango:JetBrainsMono Nerd Font 10
default_border pixel 2
default_floating_border pixel 2
gaps inner 6
gaps outer 8
focus_follows_mouse yes

#                       border    background text      indicator child_border
client.focused          #fe8019   #282828    #ebdbb2   #fe8019   #fe8019
client.focused_inactive #504945   #282828    #ebdbb2   #504945   #504945
client.unfocused        #3c3836   #282828    #d5c4a1   #3c3836   #3c3836
client.urgent           #fb4934   #282828    #ebdbb2   #fb4934   #fb4934

output * bg #1d2021 solid_color

### Input
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    middle_emulation enabled
    scroll_method two_finger
    click_method clickfinger
}

### Idle / lock
exec swayidle -w \
    timeout 300 'swaylock -f' \
    timeout 600 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f'

### Autostart
exec_always systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec mako
exec wl-paste --watch cliphist store
exec_always pkill -x waybar; waybar

### Keybindings (Omarchy-style)
bindsym $mod+Return exec $term
bindsym $mod+space exec $menu
bindsym $mod+Alt+space exec ~/.config/sway/system-menu.sh
bindsym $mod+Escape exec ~/.config/sway/system-menu.sh
bindsym $mod+k exec wofi --dmenu -p Keys < ~/.config/sway/keys.txt
bindsym $mod+w kill
bindsym $mod+Shift+b exec firefox
bindsym $mod+Shift+f exec thunar
bindsym $mod+Shift+t exec $term -e top
bindsym $mod+Ctrl+v exec cliphist list | wofi --dmenu | cliphist decode | wl-copy
bindsym $mod+Ctrl+l exec swaylock -f
bindsym $mod+Shift+c reload
bindsym $mod+comma exec makoctl dismiss
bindsym $mod+Shift+comma exec makoctl dismiss --all
floating_modifier $mod normal

### Focus / swap
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10
bindsym $mod+Tab workspace next_on_output
bindsym $mod+Shift+Tab workspace prev_on_output
bindsym $mod+Ctrl+Tab workspace back_and_forth
bindsym $mod+button4 workspace prev_on_output
bindsym $mod+button5 workspace next_on_output

### Layout
bindsym $mod+f fullscreen
bindsym $mod+v floating toggle
bindsym $mod+j layout toggle split
bindsym $mod+g layout toggle tabbed split
bindsym $mod+minus resize shrink width 100px
bindsym $mod+equal resize grow width 100px
bindsym $mod+Shift+minus resize shrink height 100px
bindsym $mod+Shift+equal resize grow height 100px

### Media / brightness / screenshots
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym Print exec grim -g "$(slurp)" - | wl-copy
bindsym Shift+Print exec grim ~/Pictures/Screenshots/$(date +%F_%H-%M-%S).png
bindsym $mod+Print exec grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%F_%H-%M-%S).png

### Window rules
for_window [app_id="org.gnome.FileRoller"] floating enable
# bar popups: drop down from the top-right, under the bar
for_window [app_id="pavucontrol"] floating enable, resize set 460 340, move absolute position 1452 40
for_window [app_id="blueman-manager|nm-connection-editor"] floating enable, resize set 460 420, move absolute position 1452 40
for_window [app_id="firefox" title="Picture-in-Picture"] floating enable, sticky enable
for_window [window_role="pop-up|dialog"] floating enable

include /etc/sway/config.d/*

exec gnome-keyring-daemon --start --components=secrets
